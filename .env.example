# ===== Lyric Motion Studio 环境变量 =====
# 复制为 .env 后填写；前端「设置」页里的配置优先级更高。

# --- DeepSeek（内容理解 / 分镜 / 提示词优化 / 配乐设计）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 生图（可选，OpenAI 兼容 /images/generations）---
# 例如 SiliconFlow: https://api.siliconflow.cn/v1  |  阿里百炼 compatible-mode/v1
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

# --- 服务与渲染 ---
PORT=5099
# 留空自动探测；也可显式指定 ffmpeg.exe / ffprobe.exe 绝对路径
FFMPEG_PATH=
FFPROBE_PATH=
# 同时渲染的分镜片段数（1-4）
RENDER_CONCURRENCY=2
# 项目根目录（默认取启动时的工作目录，一般无需设置）
# APP_ROOT=D:\clash

# --- 每日出片（scripts/daily-video.ts）---
# 运行每日出片时必须提供 DEEPSEEK_API_KEY
API_BASE=http://127.0.0.1:5099/api
